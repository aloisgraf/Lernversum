# Vorlage für .env.local (nie committen). Werte für die lokale Entwicklung
# gibt `pnpm db:start` aus.

# Öffentlich (darf im Browser landen)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Geheim (nur Server, nie mit NEXT_PUBLIC_ beginnen)
SUPABASE_SERVICE_ROLE_KEY=

# Demo-Login nur für Test-/DEV-Server (D-019). Aus, solange nicht DEMO_LOGIN=on und beide
# Passwörter (mind. 12 Zeichen, verschieden) gesetzt sind. Nie für echte Daten verwenden.
DEMO_LOGIN=
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
